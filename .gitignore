# ==============================================================================
# Ultimate WordPress Plugin GitIgnore Blueprint
# ==============================================================================

# Runtime Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup Files & Localization Backups (e.g., Loco Translate)
*.bak
*.po~
*.pot~
*~

# Test Coverage
/coverage/

# Compiled Production Artifacts & Assets
/build/
/dist/
*.tgz
*.zip

# Dependency Directories
/node_modules/
/vendor/

# Local Environment & Configurations
.env
.npm
.eslintcache

# OS-Specific Metadata Files
.DS_Store
Thumbs.db

# IDE, Editor & Project Management Folders
/.vscode/
/.idea/

# .editorconfig - mag je in git laten gaan.